{
    email {$ACME_EMAIL}
}

homeserver.{$TS_DOMAIN} {
    bind {$BIND_IP}
    root * /srv/landing
    file_server
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

home.{$TS_DOMAIN} {
    bind {$BIND_IP}
    reverse_proxy {$BIND_IP}:{$PORT_HOME}
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

